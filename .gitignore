# =============================================================================
# dllm-cross-model-hd — version control ignores
# =============================================================================
# Principle: everything generated by the pipeline is reproducible from
# `scripts/download_raw.py` (sha256-verified raw index) plus
# `scripts/build_dataset.py` (recorded manifest), so bulk artifacts stay out of
# git while the small provenance files that make them reproducible stay in.

# --- environments ------------------------------------------------------------
.venv/
.venv*/
venv/
__pycache__/
*.py[cod]

# --- sandbox / tooling scratch (see docs/ENVIRONMENT.md) ---------------------
# Inward-pointed uv and pip caches used on locked-down hosts.
.uvcache/
.uvpython/
.uvtools/
.uvbin/
.tmp/
.pipcache/

# Host-specific workaround for locked-down sandboxes: reimplements
# tempfile.mkdtemp with default directory permissions.  Not part of the project;
# see docs/ENVIRONMENT.md for how to regenerate it.
_pyfix/

# --- test + coverage ---------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# --- bulk generated data (reproducible; never committed) ---------------------
data/raw_download/
data/trajectories/
data/generations/
data/features/

# --- bulky results -----------------------------------------------------------
results/
reports/*.png
reports/*.pdf

# --- editor / OS -------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local test scratch and generated labels
pytest-of-*/
data/labels/
# TRE reproduction (v3) judge outputs: contain full responses and raw judge payloads
data/tre_repro/labels/

# stability study resume file (kept when a run stops early; not a deliverable)
reports/*.checkpoint.json
